{
  "name": "MTG Tracker",
  "short_name": "MTG Tracker",
  "description": "Daily prices for Commander precons released since 2021, plus sealed booster boxes and set bundles from the same sets, checked at TCGplayer and Card Kingdom, with price history and buy signals.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#15120e",
  "theme_color": "#15120e",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
